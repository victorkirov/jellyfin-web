log_format perf '$time_iso8601 $remote_addr $args';

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    client_max_body_size 0;

    location /web/ {
        root /usr/share/nginx/html;
        access_log off;

        location ~ (index\.html|config\.json|manifest\.json|serviceworker\.js)$ {
            add_header Cache-Control "no-cache";
        }

        location ~ \.(js|css|woff2?|ttf|png|jpg|svg|wasm)$ {
            expires 30d;
        }
    }

    location = /web {
        return 301 /web/;
    }

    location = /perf {
        access_log /dev/stdout perf;
        add_header Cache-Control "no-store";
        return 204;
    }

    location /socket {
        proxy_pass ${JELLYFIN_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    location / {
        proxy_pass ${JELLYFIN_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }
}
